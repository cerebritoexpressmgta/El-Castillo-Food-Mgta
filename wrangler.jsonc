{
  "name": "el-castillo-food-mgta",
  "main": "worker/index.mjs",
  "compatibility_date": "2025-01-01",
  // Evita que cada despliegue borre las variables que pongas a mano en el panel de Cloudflare
  "keep_vars": true,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Solo datos NO secretos. Las llaves (SUPABASE_SERVICE_KEY, JWT_SECRET) van como "Secreto" en el panel.
  "vars": {
    "SUPABASE_URL": "https://cncrupyxesbzinvjunqm.supabase.co"
  },
  // 12:00 UTC = 8:00 a. m. Venezuela: despierta Supabase y actualiza la tasa BCV.
  // Las otras dos (10:00 a. m. y 1:00 p. m.) solo reintentan la tasa si la de la mañana falló.
  "triggers": { "crons": ["0 12 * * *", "0 14 * * *", "0 17 * * *"] },
  "observability": { "enabled": true }
}
